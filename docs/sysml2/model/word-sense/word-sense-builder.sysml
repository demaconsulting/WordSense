package WordSense {
    part def WordSenseBuilder {
        doc /* Non-shipped build-time tool that derives the dictionary word list from the pinned Moby list, compiles the embedded word lexicon and sense catalog from the data with the generated inflected forms of every dictionary word, measures the token coverage of the lexicon on plain-text files, reports the per-sense quota of the corpus, trains the fine-sense weights of each encoder model and chooses the per-lemma thresholds by cross-validation, counts Universal Dependencies tag statistics, trains, tunes and measures the statistical basic model, measures the shipped models at each answer level on the held-out sentences, on SemCor and on running text, and generates the senses appendix of the user guide. */

        comment sourceRef /* Source: tools/WordSense.Builder/ (every C# file of the builder project, for example Program.cs, Corpus.cs, SenseInventory.cs, LegacyCorpus.cs, LegacySenseInventory.cs, CoverageReport.cs, LexiconImporter.cs, ModelTrainer.cs, EmbeddingCache.cs, CachingEncoder.cs, FitCache.cs, WeightsTrainer.cs, LogisticTrainer.cs, KernelBasis.cs, LemmaFitter.cs, Thresholds.cs, PrecisionGate.cs, Tiers.cs, Evaluator.cs, SenseEval.cs, RunningText.cs, Suite.cs, UdCounts.cs, BasicHyperparameters.cs, BasicTrainer.cs, BasicTablesWriter.cs, BasicTuner.cs, BasicModelBuilder.cs and AppendixGenerator.cs), corpus/ (anchor and holdout sentences of the fine-sense corpus with their provenance, the legacy class-labeled corpus, the suite, lexicon, Universal Dependencies counts) */
        comment testRef /* Test: test/WordSense.Builder.Tests/ProgramTests.cs, test/WordSense.Builder.Tests/ImageTests.cs, test/WordSense.Builder.Tests/WeightsBlobWriterTests.cs, test/WordSense.Builder.Tests/UdCountsTests.cs, test/WordSense.Builder.Tests/BasicTrainerTests.cs, test/WordSense.Builder.Tests/BuilderTests.cs, test/WordSense.Builder.Tests/CorpusTests.cs, test/WordSense.Builder.Tests/LexiconTests.cs, test/WordSense.Builder.Tests/LexiconImporterTests.cs, test/WordSense.Builder.Tests/WeightsTrainerTests.cs, test/WordSense.Builder.Tests/KernelFitTests.cs, test/WordSense.Builder.Tests/ThresholdsTests.cs, test/WordSense.Builder.Tests/TiersTests.cs, test/WordSense.Builder.Tests/EmbeddingCacheTests.cs, test/WordSense.Builder.Tests/FitCacheTests.cs, test/WordSense.Builder.Tests/ModelTrainerTests.cs, test/WordSense.Builder.Tests/EvaluatorTests.cs, test/WordSense.Builder.Tests/SenseEvalTests.cs, test/WordSense.Builder.Tests/RunningTextTests.cs, test/WordSense.Builder.Tests/SuiteReaderTests.cs, test/WordSense.Builder.Tests/CoverageReportTests.cs */
        comment designRef /* Design: docs/design/word-sense/word-sense-builder.md */
        comment verificationRef /* Verification: docs/verification/word-sense/word-sense-builder.md */
        comment reqRef /* Requirements: docs/reqstream/word-sense/word-sense-builder.yaml */
    }
}
