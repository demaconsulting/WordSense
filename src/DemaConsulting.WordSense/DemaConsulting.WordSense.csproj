<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Configuration -->
    <PackageId>DemaConsulting.WordSense</PackageId>
    <Version>0.0.0</Version>
    <Authors>DEMA Consulting</Authors>
    <Company>DEMA Consulting</Company>
    <Description>Offline word-sense disambiguation for .NET: the English word lexicon (lemma, part of speech, sense id, features) plus the model contract (IWordSenseModel) and result types. Has no ONNX dependency; add DemaConsulting.WordSense.Basic, .MiniLM or .BertBaseCased to disambiguate words in context.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/demaconsulting/WordSense</PackageProjectUrl>
    <RepositoryUrl>https://github.com/demaconsulting/WordSense</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageTags>wordsense;word-sense-disambiguation;nlp;lexicon;dotnet-library</PackageTags>
    <Copyright>Copyright DEMA Consulting</Copyright>
    <Title>WordSense</Title>
    <Product>WordSense</Product>

    <!-- Symbol Package Configuration -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- API Documentation Configuration -->
    <!-- ApiMark turns this project's XML doc comments into gradually-disclosed Markdown API
         reference (index -> namespace -> type -> member) for a coding agent to read.
         - Output goes under 'generated/', which the repository already excludes from git,
           markdownlint, and cspell, so the build regenerates it and nothing stale is committed.
         - ApiMarkPackDocs ships the generated api/ tree inside the nupkg, so a consuming agent
           receives the reference with the library.
         - ApiMarkEnforceDocs fails the build on any public API member lacking an XML doc
           summary; the Public tier matches the surface that is generated and shipped. -->
    <ApiMarkOutputDir>$(MSBuildProjectDirectory)\generated\api</ApiMarkOutputDir>
    <ApiMarkVisibility>Public</ApiMarkVisibility>
    <ApiMarkPackDocs>true</ApiMarkPackDocs>
    <ApiMarkEnforceDocs>Public</ApiMarkEnforceDocs>
    <ApiMarkEnforceDocsSeverity>Error</ApiMarkEnforceDocsSeverity>

    <!-- SBOM Configuration -->
    <GenerateSBOM>true</GenerateSBOM>
    <SBOMPackageName>$(PackageId)</SBOMPackageName>
    <SBOMPackageVersion>$(Version)</SBOMPackageVersion>
    <SBOMPackageSupplier>Organization: $(Company)</SBOMPackageSupplier>
  </PropertyGroup>

  <!-- Build Tool Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.13" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.402" PrivateAssets="All" />
    <!-- Build-time only: PrivateAssets="All" keeps the documentation generator out of any
         package that consumes this library. -->
    <PackageReference Include="DemaConsulting.ApiMark.MSBuild" Version="0.5.11" PrivateAssets="All" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <!-- Analyzer packages use child-element form to configure both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" prevents these build-time analyzers from becoming transitive dependencies
           in packages that consume this library.
         - IncludeAssets lists all asset types (including 'analyzers' and 'buildtransitive') to ensure
           Roslyn analyzers and MSBuild targets are fully activated during the build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.402">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.WordSense.Tests" />
    <InternalsVisibleTo Include="WordSense.Builder" />
    <InternalsVisibleTo Include="WordSense.Builder.Tests" />
    <InternalsVisibleTo Include="DemaConsulting.WordSense.Basic" />
    <InternalsVisibleTo Include="DemaConsulting.WordSense.Basic.Tests" />
    <InternalsVisibleTo Include="DemaConsulting.WordSense.Onnx" />
    <InternalsVisibleTo Include="DemaConsulting.WordSense.Onnx.Tests" />
    <InternalsVisibleTo Include="DemaConsulting.WordSense.MiniLM.Tests" />
    <InternalsVisibleTo Include="DemaConsulting.WordSense.BertBaseCased.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The word image is generated by 'WordSense.Builder compile-image' and embedded in the assembly; a missing image must fail the build. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\wordsense.img" LogicalName="DemaConsulting.WordSense.wordsense.img" />
  </ItemGroup>

</Project>
