# Set default behavior: normalize line endings to LF on checkout for all text files.
# This ensures consistent SHA256 fingerprints for reviewmark across all platforms.
* text=auto eol=lf

# Windows batch files require CRLF line endings to function correctly.
*.bat text eol=crlf
*.cmd text eol=crlf

# Downloadable model assets are stored in Git LFS (one media URL pattern serves every file).
model/** filter=lfs diff=lfs merge=lfs -text
# Documentation and checksums stay as plain text so they remain readable on GitHub.
model/*/README.md text eol=lf -filter -diff -merge
model/*/SHA256SUMS text eol=lf -filter -diff -merge
model/*/LICENSE text eol=lf -filter -diff -merge
